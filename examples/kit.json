{
  "$schema": "https://raw.githubusercontent.com/3meyc/agent-kit/stable/schema/kit.schema.json",
  "project": "my-app",
  "baseBranch": "dev",
  "itemPrefix": "APP",
  "ledger": true,
  "paths": {
    "docs": "docs",
    "decisions": "docs/decisions",
    "sdlc": "docs/sdlc",
    "glossary": "docs/glossary.md",
    "recipes": "docs/recipes",
    "ledger": ".claude/ledger"
  },
  "commands": {
    "install": "pnpm install --frozen-lockfile",
    "dev": "pnpm run dev",
    "check": "pnpm run check",
    "lint": "pnpm run lint",
    "test": "pnpm test",
    "build": "pnpm run build",
    "commit": "node scripts/commit.mjs",
    "land": "node scripts/land.mjs",
    "commitAudit": "npx some-audit --base HEAD~1 --only {files}"
  },
  "lintOnEdit": [
    { "command": "pnpm exec eslint --no-warn-ignored {file}", "match": ["*.ts", "*.svelte"] },
    { "command": "pnpm run i18n:check", "match": ["src/locales/*.json"] }
  ],
  "checks": {
    "i18n": ["pnpm run i18n:check", "pnpm run i18n:parity"],
    "docs": ["pnpm run docs:check"]
  },
  "preflight": {
    "docs-review": { "description": "Docs review: the project's docs-review skill", "match": ["docs/**", "*.md"], "remindAfter": 3, "scope": "main" },
    "audit": { "description": "Dead-code and dependency audit", "command": "pnpm run audit" }
  },
  "parentFiles": ["CHANGELOG.md", "docs/roadmap.md"],
  "regenerate": [{ "match": ["src/locales/types.ts"], "command": "pnpm run i18n:types" }],
  "hooks": {
    "off": [
      "ledger-stop"
    ]
  },
  "devServer": { "port": 5173 }
}
