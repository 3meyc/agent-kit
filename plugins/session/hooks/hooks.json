{
  "description": "agent-kit session plugin. Each hook has a stable id (see the plugin README); a project skips one by listing its id in kit.json hooks.off. Ledger hooks run only when kit.json sets \"ledger\": true.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/worktree-setup-hook.mjs\"",
            "timeout": 180
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/ledger-brief.mjs\"",
            "timeout": 20
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/session-ledger.mjs\"",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
